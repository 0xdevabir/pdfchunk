# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Generation model used for chunk / section / document summaries
GEMINI_MODEL=gemini-2.5-flash
# Embedding model used by the "semantic" chunking strategy
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Max parallel Gemini requests (lower this if you hit 429 rate limits on the free tier)
GEMINI_CONCURRENCY=4
GEMINI_MAX_RETRIES=5

PDFCHUNK_DATA_DIR=data
PDFCHUNK_MAX_UPLOAD_MB=100
